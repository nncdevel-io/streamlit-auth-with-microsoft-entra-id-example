# Microsoft Entra ID Configuration
# Copy this file to .env and fill in the values from Azure Portal
#
# Note: In development, config is read from .env file only.
# In production (ENV=production), config is read from environment variables only.

# Application (client) ID from App Registration
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret from Certificates & secrets
AZURE_CLIENT_SECRET=your-client-secret

# Directory (tenant) ID
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Redirect URI (must match App Registration)
AZURE_REDIRECT_URI=http://localhost:8501/

# Custom CA certificate file (optional, for corporate proxy environments)
# SSL_CA_FILE=/path/to/your/ca.pem
